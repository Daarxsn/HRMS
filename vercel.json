{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "client/",
      "framework": "vite"
    },
    "backend": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/index.mts"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://accounts.google.com https://www.gstatic.com 'sha256-sF3+ljzTjIn7X4lZ7giexRXRkP/3UlaUXikP4sSYOGU='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/sw.js",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/manifest.webmanifest",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/pwa-icon.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/falchion-xeniaa-mark.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/falchion-xeniaa-horizontal.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/login-architectural-scene.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/login-architectural-scene.webp",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/favicon.ico",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
