# Copy to server/.env for local use. Never commit real secrets.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=376612868492-a247s4dgh145nemiavg2h7lpcvdc0l7b.apps.googleusercontent.com
DEMO_AUTH_ENABLED=true
DEMO_APP_URL=http://localhost:3000
# Office public egress IP(s), separated by semicolons. Local default is localhost.
OFFICE_NETWORK_IPS=127.0.0.1;::1

# MySQL. In production use a private Cloud SQL connection over the Cloud SQL connector/socket.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=falchion_xeniaa
DB_USER=falchion_app
DB_PASSWORD=replace-me
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_TRANSACTION_RETRIES=2
# Optional Cloud SQL Unix socket, e.g. /cloudsql/project:region:instance
DB_SOCKET_PATH=

# Private Google Cloud Storage bucket for leave attachments.
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
# Required for GCS on Vercel: one-line JSON for a narrowly scoped service account.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Frontend only. Set the deployed Cloud Run API URL before building for Vercel.
VITE_API_URL=http://localhost:3001/api
VITE_GOOGLE_CLIENT_ID=376612868492-a247s4dgh145nemiavg2h7lpcvdc0l7b.apps.googleusercontent.com
