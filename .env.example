# Copy local values to server/.env; never commit real secrets.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=your-google-web-client-id
DEMO_AUTH_ENABLED=true
DEMO_APP_URL=http://localhost:3000
# Office public egress IP(s), separated by semicolons. Local default is localhost.
OFFICE_NETWORK_IPS=127.0.0.1;::1

# MySQL. Production uses an encrypted remote MySQL service (for example Aiven).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=falchion_xeniaa
DB_USER=falchion_app
DB_PASSWORD=replace-me
DB_SSL_MODE=
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_TRANSACTION_RETRIES=2
# Optional MySQL Unix socket for environments such as Cloud SQL.
DB_SOCKET_PATH=

# Production file storage is Vercel Blob. Create a private Blob store from the Vercel project.
# Vercel provides the required Blob authentication; do not place Blob credentials here.

# Frontend local-development values.
VITE_API_URL=http://localhost:3001/api
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id
