{
  "name": "falchion-xeniaa-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "migrate": "node dist/src/migrate.js",
    "seed": "node dist/src/seed.js",
    "db:verify": "node --experimental-strip-types test/database-smoke.ts",
    "test:integration": "node --experimental-strip-types test/integration.ts",
    "test": "node --experimental-strip-types --test test/policy.test.ts test/production-contract.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.5",
    "qrcode": "^1.5.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.8.3"
  }
}
